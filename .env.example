# ============================================================
# MedIntel configuration  (paste your own key below - never commit this file)
# ============================================================
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_TEMPERATURE=0.1

# ---- Response size (was 1000) -------------------------------
# gemini-2.5-* supports up to 65536 output tokens, gemini-2.0-* up to 8192
MAX_TOKENS=8192
MAX_CONTINUATIONS=2

# ---- FAISS retrieval size (was TOP_K 5, THRESHOLD 0.75) ------
TOP_K_DOCUMENTS=12
MAX_TOP_K=30
FETCH_K_MULTIPLIER=3
RETRIEVAL_CONFIDENCE_THRESHOLD=0.30

# ---- Context window sent to the LLM ---------------------------
NEIGHBOR_WINDOW=1
MAX_CONTEXT_CHARS=60000
HISTORY_TURNS=6

# ---- API ------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# ---- Vector store (applies to newly ingested documents) --------
VECTOR_STORE_PATH=./data/vector_store
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ---- UI ---------------------------------------------------------
FEEDBACK_PATH=./data/feedback/feedback.jsonl
PUBMED_EMAIL=
